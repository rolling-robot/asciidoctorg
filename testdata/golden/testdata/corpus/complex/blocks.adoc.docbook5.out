<section xml:id="_delimited_blocks">
<title>Delimited Blocks</title>
<formalpara xml:id="listing-1">
<title>Listing title</title>
<para>
<programlisting language="ruby" linenumbering="unnumbered">def hello name
  puts "Hello, #{name}!" <co xml:id="CO1-1"/>
end
hello 'world' <co xml:id="CO1-2"/></programlisting>
</para>
</formalpara>
<calloutlist>
<callout arearefs="CO1-1">
<para>Prints a greeting</para>
</callout>
<callout arearefs="CO1-2">
<para>Calls the method</para>
</callout>
</calloutlist>
<programlisting language="python" linenumbering="numbered">def add(a, b):
    return a + b</programlisting>
<programlisting language="javascript" linenumbering="numbered" startinglinenumber="5">console.log("literal-delimited source");</programlisting>
<literallayout class="monospaced">Literal block
  preserves   spacing</literallayout>
<literallayout class="monospaced">Indented literal paragraph.</literallayout>
<literallayout class="monospaced">Literal styled paragraph.</literallayout>
<example>
<title>Example title</title>
<simpara>Example block with <emphasis role="strong">formatting</emphasis>.</simpara>
<note>
<simpara>Nested admonition in example.</simpara>
</note>
</example>
<example>
<title>Click to reveal</title>
<simpara>Collapsible content.</simpara>
</example>
<sidebar>
<title>Sidebar title</title>
<simpara>Sidebar content.</simpara>
</sidebar>
<blockquote>
<attribution>
Albert Einstein
<citetitle>Relativity</citetitle>
</attribution>
<simpara>Imagination is more important than knowledge.</simpara>
</blockquote>
<blockquote>
<attribution>
Carl Sandburg
<citetitle>Fog</citetitle>
</attribution>
<literallayout>The fog comes
on little cat feet.</literallayout>
</blockquote>
<blockquote>
<attribution>
Thomas Jefferson
<citetitle>Papers of Thomas Jefferson</citetitle>
</attribution>
<simpara>I hold it that a little rebellion now and then is a good thing.</simpara>
</blockquote>
<blockquote>
<simpara>Paragraph-style quote.</simpara>
</blockquote>
<simpara>Open block content.</simpara>
<abstract>
<simpara>Abstract open block.</simpara>
</abstract>
</section>
<section xml:id="_admonitions">
<title>Admonitions</title>
<note>
<simpara>A note paragraph.</simpara>
</note>
<tip>
<simpara>A tip.</simpara>
</tip>
<important>
<simpara>Important.</simpara>
</important>
<caution>
<simpara>Caution.</simpara>
</caution>
<warning>
<simpara>Warning with a footnote.<footnote><simpara>Admonition footnote.</simpara></footnote></simpara>
</warning>
<important>
<title>Admonition title</title>
<simpara>Admonition block with list:</simpara>
<itemizedlist>
<listitem>
<simpara>one</simpara>
</listitem>
<listitem>
<simpara>two</simpara>
</listitem>
</itemizedlist>
</important>
</section>
<section xml:id="_paragraph_variants">
<title>Paragraph Variants</title>
