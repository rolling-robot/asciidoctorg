<section xml:id="_callouts_in_xml">
<title>Callouts in XML</title>
<programlisting language="xml" linenumbering="unnumbered">&lt;root&gt; <co xml:id="CO2-1"/>
  &lt;child/&gt; <co xml:id="CO2-2"/>
&lt;/root&gt;</programlisting>
<calloutlist>
<callout arearefs="CO2-1">
<para>The root</para>
</callout>
<callout arearefs="CO2-2">
<para>The child</para>
</callout>
</calloutlist>
