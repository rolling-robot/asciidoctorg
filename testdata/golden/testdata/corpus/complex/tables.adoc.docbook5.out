<table xml:id="table-1" frame="topbot" rowsep="1" colsep="0">
<title>Basic table</title>
<?dbhtml table-width="80%"?>
<?dbfo table-width="80%"?>
<?dblatex table-width="80%"?>
<tgroup cols="4">
<colspec colname="col_1" colwidth="48.5713*"/>
<colspec colname="col_2" colwidth="97.1427*"/>
<colspec colname="col_3" colwidth="145.7141*"/>
<colspec colname="col_4" colwidth="48.5717*"/>
<thead>
<row>
<entry align="left" valign="top">Name</entry>
<entry align="left" valign="top">Description</entry>
<entry align="center" valign="top">Centered</entry>
<entry align="right" valign="top">Code</entry>
</row>
</thead>
<tbody>
<row>
<entry align="left" valign="top"><simpara>Alpha</simpara></entry>
<entry align="left" valign="top"><itemizedlist>
<listitem>
<simpara>list in cell</simpara>
</listitem>
<listitem>
<simpara>another</simpara>
</listitem>
</itemizedlist></entry>
<entry align="center" valign="top"><simpara>middle</simpara></entry>
<entry align="right" valign="top"><simpara><literal>x = 1</literal></simpara></entry>
</row>
<row>
<entry align="left" valign="top" namest="col_1" nameend="col_2"><simpara>Spanning two columns</simpara></entry>
<entry align="left" valign="top"><simpara>centered</simpara></entry>
<entry align="center" valign="top"><simpara>y</simpara></entry>
</row>
<row>
<entry align="left" valign="top" morerows="1"><simpara>Row span</simpara></entry>
<entry align="left" valign="top"><simpara>a</simpara></entry>
<entry align="center" valign="top"><simpara>b</simpara></entry>
<entry align="right" valign="top"><simpara><literal>c</literal></simpara></entry>
</row>
<row>
<entry align="left" valign="top"><simpara>d</simpara></entry>
<entry align="left" valign="top"><simpara>e</simpara></entry>
<entry align="center" valign="top"><simpara>f</simpara></entry>
</row>
</tbody>
<tfoot>
<row>
<entry align="left" valign="top"><simpara>Footer 1</simpara></entry>
<entry align="left" valign="top"><simpara>Footer 2</simpara></entry>
<entry align="center" valign="top"><simpara>Footer 3</simpara></entry>
<entry align="right" valign="top"><simpara><literal>Footer 4</literal></simpara></entry>
</row>
</tfoot>
</tgroup>
</table>
<informaltable frame="all" rowsep="1" colsep="1">
