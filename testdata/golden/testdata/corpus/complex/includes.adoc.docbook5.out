<article xmlns="http://docbook.org/ns/docbook" xmlns:xl="http://www.w3.org/1999/xlink" version="5.0" xml:lang="en">
<info>
<title>Includes</title>
<date>2020-01-01</date>
</info>
<section xml:id="_included_chapter">
<title>Included Chapter</title>
<simpara>Content from an included file with attribute includes.</simpara>
<section xml:id="_included_subsection">
<title>Included Subsection</title>
<simpara>More included content.</simpara>
</section>
</section>
<section xml:id="_tagged_regions">
<title>Tagged Regions</title>
<programlisting language="ruby" linenumbering="unnumbered">def greet name
  "Hello, #{name}"
end</programlisting>
<programlisting language="ruby" linenumbering="unnumbered">  def greet name
    "Hello, #{name}"
  end
  EXTRA = 1</programlisting>
<programlisting language="ruby" linenumbering="unnumbered">def greet name
  "Hello, #{name}"
end
puts greet 'you'</programlisting>
<programlisting language="ruby" linenumbering="unnumbered"># tag::method[]
def greet name
  "Hello, #{name}"
EXTRA = 1</programlisting>
</section>
<section xml:id="_missing_and_optional">
<title>Missing and Optional</title>
<simpara>Unresolved directive in includes.adoc - include::includes/does-not-exist.adoc[]</simpara>
</section>
<section xml:id="_nested_include">
<title>Nested Include</title>
<simpara>Nested level one.</simpara>
<simpara>Nested level two, resolved relative to the including file.</simpara>
</section>
<section xml:id="_csv_table_from_include">
<title>CSV Table from Include</title>
<informaltable frame="all" rowsep="1" colsep="1">
<tgroup cols="2">
<colspec colname="col_1" colwidth="50*"/>
<colspec colname="col_2" colwidth="50*"/>
<thead>
<row>
<entry align="left" valign="top">Name</entry>
<entry align="left" valign="top">Value</entry>
</row>
</thead>
<tbody>
<row>
<entry align="left" valign="top"><simpara>alpha</simpara></entry>
<entry align="left" valign="top"><simpara>1</simpara></entry>
</row>
<row>
<entry align="left" valign="top"><simpara>beta</simpara></entry>
<entry align="left" valign="top"><simpara>2</simpara></entry>
</row>
</tbody>
</tgroup>
</informaltable>
</section>
</article>